{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Amsterdam)"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "bump",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "minimumReleaseAge": "3 days",
  "platformAutomerge": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "addLabels": ["priority/high"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Only a real `uses:` reference can carry a digest. The github-actions manager also reports `uses-with` deps — the helm and golangci-lint version inputs in ci.yml — where a pinDigest update collides with the version update for the same dep and fails the whole branch.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "pinDigests": true
    },
    {
      "description": "Action updates are the highest-volume, lowest-risk stream here, and digests are already pinned. Let CI be the gate.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go-modules-non-major"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["golang"],
      "groupName": "golang-builder"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["gcr.io/distroless/static"],
      "groupName": "distroless-runtime"
    },
    {
      "description": "Transitive dependencies, covered by the 95% coverage gate. Safe to automerge on patch and minor.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": true,
      "automerge": true
    },
    {
      "description": "Direct dependencies stay under human review. There is only one, so this costs a minute every few months.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require"],
      "groupName": "go-modules-direct",
      "automerge": false
    },
    {
      "description": "The go directive is a toolchain change and must not ride along with library updates.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "groupName": "go-toolchain",
      "automerge": false
    },
    {
      "description": "Major updates are always read by a person.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GO_BUILD_IMAGE build-arg default in Dockerfiles",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "ARG GO_BUILD_IMAGE=(?<depName>[^:]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
